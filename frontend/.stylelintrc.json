{
  "plugins": ["stylelint-declaration-strict-value"],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      ["/color/", "fill", "stroke", "font-size", "box-shadow"],
      {
        "ignoreValues": [
          "transparent",
          "currentColor",
          "inherit",
          "initial",
          "unset",
          "none"
        ],
        "message": "Use a --dc-* design token (var(--dc-...)), not a hardcoded value — see frontend/CLAUDE.md"
      }
    ]
  }
}
